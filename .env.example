# Generación de creativos
OPENAI_API_KEY=

# Google Drive (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# In Netlify production, AI Gateway can inject OPENAI_API_KEY and OPENAI_BASE_URL automatically.
# Set OPENAI_API_KEY manually only when intentionally using your own OpenAI billing account.
