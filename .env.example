ADMIN_PASSWORD=
AUTH_SECRET=
SITE_OWNER_ID=owner
SITE_ORIGIN=https://tu-sitio.netlify.app
CRON_SECRET=

# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Meta: Instagram Login y Facebook Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://tu-sitio.netlify.app/api/meta/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
